{
  "name": "pic-smaller",
  "private": true,
  "version": "1.2.0",
  "description": "Pic Smaller - batch image compression desktop app powered by WebAssembly",
  "author": {
    "name": "rowink",
    "url": "https://github.com/rowink"
  },
  "homepage": "https://github.com/rowink/pic-smaller-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/rowink/pic-smaller-desktop.git"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:preview": "tsc && vite build --mode preview",
    "preview": "vite preview",
    "electron:dev": "node scripts/dev.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc",
    "format": "prettier --write --no-error-on-unmatched-pattern --ignore-unknown src/**/*",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.6",
    "@vercel/analytics": "^1.2.2",
    "antd": "^5.16.4",
    "classnames": "^2.5.1",
    "filesize": "^10.1.1",
    "get-user-locale": "^2.3.2",
    "history": "^5.3.0",
    "jszip": "^3.10.1",
    "mobx": "^6.12.3",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-responsive": "^10.0.0",
    "sprintf-js": "^1.1.3",
    "svgo": "^3.3.2"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/sprintf-js": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "prettier": "^3.2.5",
    "sass": "^1.75.0",
    "typescript": "^5.2.2",
    "vconsole": "^3.15.1",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.joye61.picsmaller",
    "productName": "Pic Smaller",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pic Smaller",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PicSmaller-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PicSmaller-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "executableName": "pic-smaller",
      "maintainer": "rowink <exi.sides@gmail.com>",
      "synopsis": "Batch image compression desktop app",
      "artifactName": "PicSmaller-${version}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "rowink <exi.sides@gmail.com>",
      "artifactName": "PicSmaller_${version}_${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "PicSmaller-${version}-${arch}.${ext}"
    }
  }
}
